rules_version = '2';
// Ellie Custom Gifts - Firestore security rules
// Firebase console > Firestore > Rules: paste all of this, change the email on the isAdmin line, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Your admin login (the email you added in Firebase Authentication)
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "YOUR-ADMIN-EMAIL@example.com";
    }
    function shortText(v, max) { return v is string && v.size() <= max; }

    // Shop catalogue: anyone can read (the shop page needs it), only you can change it
    match /config/{doc}      { allow read: if true; allow write: if isAdmin(); }
    match /products/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /colours/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /scenes/{id}       { allow read: if true; allow write: if isAdmin(); }

    // Orders: customers can place a new order, but can never read, change or delete any order.
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['createdAt','status','paid','adminNotes','customer','delivery',
                                                             'address','addressParts','notes','items','totals'])
                    && request.resource.data.status == "New"
                    && request.resource.data.paid == false
                    && request.resource.data.adminNotes == ""
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() < 60
                    && shortText(request.resource.data.customer.name, 120)
                    && shortText(request.resource.data.customer.email, 200)
                    && shortText(request.resource.data.customer.phone, 40)
                    && shortText(request.resource.data.notes, 2000)
                    && shortText(request.resource.data.address, 400);
      allow read, update, delete: if isAdmin();
    }

    // Everything else is locked
    match /{document=**} { allow read, write: if false; }
  }
}
